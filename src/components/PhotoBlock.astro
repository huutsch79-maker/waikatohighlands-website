---
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  src?: string;
  alt: string;
  aspect?: string; // CSS aspect-ratio, e.g. "4 / 3"
  rounded?: boolean;
}
const { src, alt, aspect = "4 / 3", rounded = true } = Astro.props;

// Checked at build time, not runtime — this repo's photos live in
// public/photos/ and are added either by JARVIS's farm-website module or
// through the Sveltia CMS admin. Until a given path actually exists, show
// an honest placeholder instead of a broken image icon.
const exists = src ? existsSync(path.join(process.cwd(), "public", "photos", src)) : false;
---

{
  exists ? (
    <img class:list={["photo-block", { "photo-block--rounded": rounded }]} src={`/photos/${src}`} alt={alt} style={`aspect-ratio: ${aspect}`} loading="lazy" />
  ) : (
    <div class:list={["photo-block", "photo-block--placeholder", { "photo-block--rounded": rounded }]} style={`aspect-ratio: ${aspect}`} role="img" aria-label={alt}>
      <span>Photo coming soon</span>
    </div>
  )
}

<style>
  .photo-block {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-block--rounded {
    border-radius: 0.75rem;
  }
  .photo-block--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-soft), var(--bg-alt));
    color: var(--text-muted);
    font-size: 0.85rem;
    border: 1px dashed var(--border);
  }
</style>
