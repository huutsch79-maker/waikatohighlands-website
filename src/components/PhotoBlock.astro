---
import { Image } from "astro:assets";

interface Props {
  src?: string;
  alt: string;
  aspect?: string; // CSS aspect-ratio, e.g. "4 / 3"
  rounded?: boolean;
  /** From src/photoSlots.ts — shown only on the empty-placeholder state, so "photo 2" has a stable, visible number to point at in chat until it's filled. */
  slotNumber?: number;
}
const { src, alt, aspect = "4 / 3", rounded = true, slotNumber } = Astro.props;

// Resolved against src/assets/photos/ (not public/) so Astro's real image
// pipeline (resize, re-encode, srcset) runs on it at build time — see
// Hero.astro for the fuller rationale. Checked at build time; until a
// given path actually exists, show an honest placeholder instead of a
// broken image icon. Photos are added either by JARVIS's farm-website
// module or through the Sveltia CMS admin.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/**/*.{jpeg,jpg,png,gif,webp,avif}", {
  eager: true,
});
const resolved = src ? photoFiles[`/src/assets/photos/${src}`]?.default : undefined;
---

{
  resolved ? (
    <Image
      class:list={["photo-block", { "photo-block--rounded": rounded }]}
      src={resolved}
      alt={alt}
      width={960}
      widths={[480, 720, 960]}
      sizes="(min-width: 42rem) 50vw, 100vw"
      quality="high"
      format="avif"
      style={`aspect-ratio: ${aspect}`}
      loading="lazy"
    />
  ) : (
    <div class:list={["photo-block", "photo-block--placeholder", { "photo-block--rounded": rounded }]} style={`aspect-ratio: ${aspect}`} role="img" aria-label={alt}>
      {slotNumber !== undefined && <span class="photo-block__number">Photo {slotNumber}</span>}
      <span>Photo coming soon</span>
    </div>
  )
}

<style>
  .photo-block {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-block--rounded {
    border-radius: 0.75rem;
  }
  .photo-block--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, var(--accent-soft), var(--bg-alt));
    color: var(--text-muted);
    font-size: 0.85rem;
    border: 1px dashed var(--border);
  }
  .photo-block__number {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
