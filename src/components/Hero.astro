---
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  eyebrow?: string;
  title: string;
  tagline: string;
  photo?: string;
}
const { eyebrow, title, tagline, photo } = Astro.props;
const exists = photo ? existsSync(path.join(process.cwd(), "public", "photos", photo)) : false;
---

{
  exists ? (
    <section class="hero hero--photo">
      <img class="hero__image" src={`/photos/${photo}`} alt={title} />
      <div class="wrap hero__caption">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        <p class="hero__tagline">{tagline}</p>
      </div>
    </section>
  ) : (
    <section class="hero">
      <div class="wrap">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        <p class="hero__tagline">{tagline}</p>
      </div>
    </section>
  )
}

<style>
  .hero {
    padding: 6rem 0 5rem;
    background:
      radial-gradient(circle at 12% 20%, var(--accent-soft), transparent 55%),
      radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--sage) 18%, transparent), transparent 50%),
      var(--bg);
  }
  .hero__tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 38rem;
  }

  .hero--photo {
    padding: 0 0 3.5rem;
  }
  .hero__image {
    display: block;
    width: 100%;
    height: min(70vh, 640px);
    object-fit: cover;
  }
  .hero--photo .hero__caption {
    padding-top: 2.5rem;
  }
</style>
