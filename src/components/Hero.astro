---
import { Image } from "astro:assets";

interface Props {
  eyebrow?: string;
  title: string;
  tagline: string;
  photo?: string;
}
const { eyebrow, title, tagline, photo } = Astro.props;

// Eager-imported at build time so Astro's real image pipeline (resize,
// re-encode, srcset) runs on these — the opposite of public/, which serves
// whatever bytes were uploaded, unprocessed, at whatever resolution they
// came in at. Keyed by the same relative path convention as before (e.g.
// "home/hero.jpg"), so JARVIS's farm-website module and the CMS didn't
// need to change how they refer to a photo, only where the bytes land.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/photos/**/*.{jpeg,jpg,png,gif,webp,avif}", {
  eager: true,
});
const resolved = photo ? photoFiles[`/src/assets/photos/${photo}`]?.default : undefined;
---

{
  resolved ? (
    <section class="hero hero--photo">
      <Image
        class="hero__image"
        src={resolved}
        alt={title}
        width={1920}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        quality="high"
        format="avif"
        loading="eager"
        fetchpriority="high"
      />
      <div class="wrap hero__caption">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        <p class="hero__tagline">{tagline}</p>
      </div>
    </section>
  ) : (
    <section class="hero">
      <div class="wrap">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        <p class="hero__tagline">{tagline}</p>
      </div>
    </section>
  )
}

<style>
  .hero {
    padding: 6rem 0 5rem;
    background:
      radial-gradient(circle at 12% 20%, var(--accent-soft), transparent 55%),
      radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--sage) 18%, transparent), transparent 50%),
      var(--bg);
  }
  .hero__tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 38rem;
  }

  .hero--photo {
    position: relative;
    padding: 0;
    overflow: hidden;
  }
  .hero__image {
    display: block;
    width: 100%;
    height: min(76vh, 700px);
    object-fit: cover;
    object-position: center 40%;
    transform-origin: center 45%;
    animation:
      hero-fade 900ms ease-out both,
      hero-zoom 24s ease-out 900ms both;
  }

  /* Scrim behind the caption so title/tagline stay legible over any
     photo, without needing to know that photo's brightness in advance. */
  .hero--photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 16, 12, 0.75) 0%, rgba(20, 16, 12, 0.35) 32%, rgba(20, 16, 12, 0) 60%);
    pointer-events: none;
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image {
      animation: none;
    }
  }
  .hero--photo .hero__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 0 2.75rem;
    color: #fff;
  }
  .hero--photo .hero__caption h1 {
    color: #fff;
  }
  .hero--photo .hero__caption .eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }
  .hero--photo .hero__caption .hero__tagline {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
