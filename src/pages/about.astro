---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PhotoBlock from "../components/PhotoBlock.astro";
import { slotNumberFor } from "../photoSlots";

const entry = await getEntry("pages", "about");
const { title, sections } = entry!.data;
---

<Layout title={title}>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">About</span>
      <h1>{title}</h1>
      {
        sections.map((section) => (
          <div class="about-row">
            <div>
              {section.heading && <h2>{section.heading}</h2>}
              <p>{section.body}</p>
            </div>
            <PhotoBlock src={section.photo} alt={section.heading ?? section.key} slotNumber={slotNumberFor("about", section.key)} />
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .about-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin: 3rem 0;
  }
  @media (max-width: 42rem) {
    .about-row {
      grid-template-columns: 1fr;
    }
  }
</style>
