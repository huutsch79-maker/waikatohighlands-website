---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PhotoBlock from "../components/PhotoBlock.astro";

const entry = await getEntry("pages", "home");
const { sections } = entry!.data;
const hero = sections.find((s) => s.key === "hero");
const rest = sections.filter((s) => s.key !== "hero");
---

<Layout title="Home">
  <Hero eyebrow="A family farm" title={hero?.heading ?? "Waikato Highlands"} tagline={hero?.body ?? ""} photo={hero?.photo} />
  {
    rest.map((section) => (
      <section class="section">
        <div class="wrap intro-grid">
          <div>
            {section.heading && <h2>{section.heading}</h2>}
            <p>{section.body}</p>
            <p><a href="/about">Meet the family &rarr;</a></p>
            <p><a href="/farm">See the farm &rarr;</a></p>
          </div>
          <PhotoBlock src={section.photo} alt={section.heading ?? section.key} aspect="4 / 3" />
        </div>
      </section>
    ))
  }
</Layout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 42rem) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
