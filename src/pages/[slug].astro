---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PhotoBlock from "../components/PhotoBlock.astro";
import { slotNumberFor } from "../photoSlots";

export async function getStaticPaths() {
  const reservedSlugs = new Set(["home", "about", "farm"]);
  const pages = await getCollection("pages");
  return pages
    .filter((entry) => !reservedSlugs.has(entry.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, sections } = entry.data;
---

<Layout title={title}>
  <section class="section">
    <div class="wrap">
      <h1>{title}</h1>
      {
        sections.map((section) => (
          <div class="page-row">
            <div>
              {section.heading && <h2>{section.heading}</h2>}
              <p>{section.body}</p>
            </div>
            <PhotoBlock src={section.photo} alt={section.heading ?? section.key} slotNumber={slotNumberFor(entry.id, section.key)} />
          </div>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    margin: 3rem 0;
  }
  @media (max-width: 42rem) {
    .page-row {
      grid-template-columns: 1fr;
    }
  }
</style>
